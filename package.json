{
  "name": "gtm-platform-website-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start -p $PORT",
    "lint": "eslint .",
    "lint:fix": "yarn lint --fix",
    "prettify": "prettier . --write",
    "check-types": "tsc --noEmit",
    "test:jest": "jest",
    "test:security": "jest --testPathPattern=__tests__/unit/security",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "format:fix": "yarn lint:fix && yarn prettify",
    "sanity": "yarn format:fix && yarn check-types && yarn test:jest --passWithNoTests && yarn test:e2e"
  },
  "dependencies": {
    "@chakra-ui/form-control": "^2.2.0",
    "@chakra-ui/react": "^3.15.1",
    "@chakra-ui/system": "^2.6.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^5.0.1",
    "@tanstack/react-query": "^5.71.1",
    "@tanstack/react-query-devtools": "^5.74.4",
    "axios": "^1.8.4",
    "date-fns": "^4.1.0",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.487.0",
    "next": "15.2.9",
    "next-themes": "^0.4.6",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-hook-form": "^7.56.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.51.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/jest": "^29.5.14",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.2.9",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --check"
    ]
  }
}
